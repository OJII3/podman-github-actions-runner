# Must be an absolute path and must be the same path inside the runner container.
# The extracted GitHub Actions runner files go in this directory.
RUNNER_ROOT=/home/ojii3/actions-runner/tuatmcc/SchoolFestival2026
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# Repository or organization URL used by config.sh.
RUNNER_URL=https://github.com/OWNER/REPOSITORY
RUNNER_NAME=schoolfestival-podman
RUNNER_LABELS=podman

# Generate this in GitHub Settings > Actions > Runners.
RUNNER_TOKEN=replace-me
